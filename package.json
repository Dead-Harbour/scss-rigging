{
    "author": "ChrisOfNormandy",
    "description": "A collection of styles to make routine designs simpler.",
    "license": "MIT",
    "name": "@dead-harbour/scss-rigging",
    "packageManager": "yarn@4.19.0",
    "type": "module",
    "version": "1.0.9",
    "files": [
        "scss",
        "dist"
    ],
    "exports": {
        "./*": "./scss/*",
        "./config": {
            "import": "./dist/config.js",
            "require": "./dist/config.js",
            "types": "./dist/config.d.ts"
        },
        "./themes": {
            "import": "./dist/ThemeOptions.js",
            "require": "./dist/ThemeOptions.js",
            "types": "./dist/ThemeOptions.d.ts"
        },
        "./types": {
            "import": "./dist/types.js",
            "require": "./dist/types.js",
            "types": "./dist/types.d.ts"
        }
    },
    "dependencies": {
        "sass": "^1.108.2"
    },
    "devDependencies": {
        "@dead-harbour/shipshape": "1.0.9",
        "@stylistic/stylelint-config": "^6.1.0",
        "@stylistic/stylelint-plugin": "^6.0.1",
        "@types/node": "^26.6.11",
        "knip": "^6.49.0",
        "oxfmt": "^0.80.0",
        "oxlint": "^1.95.0",
        "oxlint-tsgolint": "^7.0.2009",
        "postcss": "^8.5.34",
        "stylelint": "^18.1.0",
        "stylelint-config-standard": "^41.1.0",
        "stylelint-config-standard-scss": "^18.0.0",
        "stylelint-scss": "^7.5.0",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "sass": ">=1.100"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "lint": "oxlint . --fix; oxfmt; yarn stylelint '**/*.scss'",
        "sanity": "yarn typecheck && yarn lint && yarn knip",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    }
}